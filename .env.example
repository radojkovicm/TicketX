# Kopiraj u .env i popuni pravim vrednostima. NE commit-uj .env!

# --- SMTP / Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mailer@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_SENDER_EMAIL=your-mailer@example.com
SMTP_SENDER_NAME=Ticketx System
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Notifikacije ---
EXCLUDE_ACTOR_FROM_NOTIFICATIONS=true
NOTIFY_IT_ADMINS_WHEN_ASSIGNED_TO_IT=true
IT_MAILBOX=it-support@example.com

# --- Aplikacija ---
APP_BASE_URL=http://localhost:5000
# Generisi novi: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-random-64-hex-string
IS_HTTPS=false

# --- Inicijalni admin (samo za prvi setup) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin123!
INITIAL_ADMIN_FULLNAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
# Postavi na true POSLE prvog uspesnog startovanja
DISABLE_INITIAL_ADMIN_CREATION=false

# --- Baza / logovi / ostalo ---
DB_PATH=database.db
LOG_FILE_PATH=ticketx.log
TIMEZONE=Europe/Belgrade
SESSION_TIMEOUT_SECONDS=3600
ENABLE_ASYNC_EMAIL=true
