# Copy this file to .env and replace every placeholder. Never commit .env.

# SMTP / email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mailer@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_SENDER_EMAIL=your-mailer@example.com
SMTP_SENDER_NAME=Ticketx System
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Notifications
EXCLUDE_ACTOR_FROM_NOTIFICATIONS=true
NOTIFY_IT_ADMINS_WHEN_ASSIGNED_TO_IT=true
IT_MAILBOX=it-support@example.com

# Application
APP_BASE_URL=http://localhost:5000
HOST=127.0.0.1
PORT=5000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-random-64-hex-string
IS_HTTPS=false

# Initial administrator (first setup only)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
INITIAL_ADMIN_FULLNAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
# Set to true after the first successful startup.
DISABLE_INITIAL_ADMIN_CREATION=false

# Storage, logging and runtime
DB_PATH=database.db
UPLOAD_FOLDER=uploads
LOG_FILE_PATH=ticketx.log
TIMEZONE=Europe/Belgrade
SESSION_TIMEOUT_SECONDS=3600
ENABLE_ASYNC_EMAIL=true
